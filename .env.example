# ==========================================
# DISCORD BOT CREDENTIALS
# ==========================================
# Get these from: https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here

# The exact redirect URI configured in Discord Developer Portal (OAuth2 tab)
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ==========================================
# SERVER & DASHBOARD CONFIGURATION
# ==========================================
PORT=3000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_change_me_in_production_royal_bot
DASHBOARD_URL=http://localhost:3000

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# SQLite for local plug-and-play development:
DATABASE_URL="file:./dev.db"
# For PostgreSQL in Production:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/royalbot?schema=public"
