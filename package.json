{
  "name": "royal-discord-bot-suite",
  "version": "1.0.0",
  "description": "Production Ready Royal Discord Bot with Luxury Dark & Gold Web Dashboard",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build:backend": "tsc -p tsconfig.json",
    "build:dashboard": "npm --prefix dashboard install --include=dev && npm --prefix dashboard run build",
    "build": "npx prisma generate && npm run build:dashboard && npm run build:backend",
    "start": "npx prisma db push && node dist/src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push"
  },
  "keywords": [
    "discord-bot",
    "dashboard",
    "slash-commands",
    "luxury-gold"
  ],
  "author": "Royal Bot Engineering",
  "license": "MIT",
  "dependencies": {
    "@discordjs/voice": "^0.19.0",
    "@distube/ytdl-core": "^4.16.12",
    "@prisma/client": "^5.14.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "axios": "^1.7.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "discord.js": "^14.16.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.0",
    "ffmpeg-static": "^5.2.0",
    "jsonwebtoken": "^9.0.2",
    "libsodium-wrappers": "^0.8.4",
    "opusscript": "^0.0.8",
    "play-dl": "^1.9.7",
    "prisma": "^5.14.0",
    "prism-media": "^1.3.5",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {}
}
